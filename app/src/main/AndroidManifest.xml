<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android silences a bare background recorder, so the take records under a microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Plain http is gated by the Allow insecure (http) endpoints switch, not by the platform.
         fullBackupContent is not declared: dataExtractionRules replaces it from Android 12 and minSdk is 33. -->
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Voxdroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Voxdroid" />

        <activity
            android:name=".TryActivity"
            android:exported="false"
            android:theme="@style/Theme.Voxdroid" />

        <service
            android:name=".VoxdroidA11yService"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_entry" />
        </service>
        <!-- emoji2 would ask Google Play services for an emoji font on resume; androidx.startup is not on
             lint's classpath, hence the MissingClass ignore. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
