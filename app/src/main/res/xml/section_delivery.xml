<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_no_field_mode">
        <CheckBoxPreference
            android:key="no_field_refuse"
            android:persistent="false"
            android:title="@string/settings_no_field_refuse"
            android:widgetLayout="@layout/preference_widget_radio" />
        <CheckBoxPreference
            android:key="no_field_clipboard"
            android:persistent="false"
            android:title="@string/settings_no_field_clipboard"
            android:widgetLayout="@layout/preference_widget_radio" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/dictation_log_category">
        <SwitchPreferenceCompat
            android:key="dictation_log"
            android:persistent="false"
            android:summary="@string/dictation_log_summary"
            android:title="@string/dictation_log" />
        <Preference
            android:key="show_dictation_log"
            android:summary="@string/dictation_log_show_summary"
            android:title="@string/dictation_log_show" />
        <Preference
            android:key="delete_dictation_log"
            android:summary="@string/dictation_log_delete_summary"
            android:title="@string/dictation_log_delete" />
    </PreferenceCategory>

</PreferenceScreen>
