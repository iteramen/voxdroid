<?xml version="1.0" encoding="utf-8"?>
<io.github.iteramen.voxdroid.PillLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="@drawable/pill_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="18dp"
    android:paddingEnd="8dp">

    <View
        android:id="@+id/pill_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/dot" />

    <TextView
        android:id="@+id/pill_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        android:maxWidth="220dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/pill_primary"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="64dp"
        android:textColor="#FFFFFFFF" />

    <Button
        android:id="@+id/pill_cancel"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/pill_cancel"
        android:text="✕"
        android:textColor="#FFFFFFFF" />
</io.github.iteramen.voxdroid.PillLayout>
